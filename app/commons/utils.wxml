<template name="utils">
  <mp-half-screen-dialog 
    show="{{fbi_show}}"
    title="戒期信息" 
    subTitle="{{year}}-{{month}}-{{day}},{{lunarDateMD}}">
      <view slot='desc'>
          <text>{{fbiDesc}}</text>
      </view>

  </mp-half-screen-dialog>

  <mp-half-screen-dialog 
    show="{{mottos_show}}"
    title="清心格言" >
      <view slot='desc'>
          <text>{{mottos4Month}}</text>
      </view>

  </mp-half-screen-dialog>
</template>