<template name="utils">
  <mp-half-screen-dialog 
    show="{{fbi_show}}"
    title="戒期信息" 
    subTitle="{{year}}-{{month}}-{{day}},{{lunarDateMD}}">
      <view slot='desc'>
        <view class="weui-panel__bd">
            <view class="{{avsEvents==''? 'nodisplay':'weui-media-box weui-media-box_text'}}">
                <view class="weui-media-box__title weui-media-box__title_in-text">自定义戒期</view>
                <view class="sk_weui-media-box__desc">{{avsEvents}}</view>
            </view>
            <view class="weui-media-box weui-media-box_text">
                <view class="weui-media-box__title weui-media-box__title_in-text">通用戒期</view>
                <view class="sk_weui-media-box__desc">{{skEvents}}</view>
            </view>
        </view>      
      </view>

  </mp-half-screen-dialog>

  <mp-half-screen-dialog 
    show="{{mottos_show}}"
    title="清心格言" >
      <view slot='desc'>
          <text>{{mottos4Month}}</text>
      </view>

  </mp-half-screen-dialog>
</template>