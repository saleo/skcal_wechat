/**app.wxss**/
/* pages/index/index.wxss */

.banner{
  height: 100%;
  position: relative;
}

.banner_image {
  width: 100%;
  z-index: 1;
  /* position: absolute; */
}

.banner_text {
  z-index: 100;
  position: absolute;    
  line-height: 200rpx;
  color: green;
  left: 5%;
  top: 5%;
  font-size: x-large ;
}

.op_navigate_bar{
  display: flex;
  justify-content: space-between ;
  align-items: center;
}

.hr_divider{
  width: 15%;
  height: 2rpx;
  background-color: green;
  /* border-bottom: 2rpx green solid; */
}

.op_image{
  height: 20px;
  width: 20px;
  margin: 15px,15px;
}
.bottom{
  height: fit-content;
  position: relative;
}

.bottom_image {
  width: 100%;
  z-index: 1;
  /* position: absolute; */
}

.bottom_companyName {
  z-index: 100;
  position: absolute;
  top: 20%;    
  left: 25%;
  font-size: medium;
}
.bottom_text31 {
  z-index: 100;
  position: absolute; 
  top: 50%  ; 
  left: 30%;
  font-size: small; 
  text-align: center;
}
.cls_info_content {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  align-content: space-between;
  box-sizing: border-box;
  position: relative;
  padding: 17rpx 0;
  height: 600rpx;
}
.weui-tabs-bar__wrp {
  border-bottom: 1px solid #eee;
  margin-top: 10px;
}

.weui-tabs-swiper {
  width: 100%;
  height: 580rpx;
}

.tab-content {
  height: 100%;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding: 10rpx;
  white-space:pre-wrap;
  font-size: medium;
}

.weui-tabs-bar__title {
  margin: 0px 10px;
}

.tab-bar-title__selected {
  font-size: 20px;
  font-weight: bold;
}