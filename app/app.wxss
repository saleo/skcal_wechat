/**app.wxss**/
@import 'miniprogram_npm/weui-miniprogram/weui-wxss/dist/style/weui.wxss';

.banner{
  height: 100%;
  position: relative;
}

.banner_image {
  width: 100%;
  z-index: 1;
  /* position: absolute; */
}

.banner_text {
  z-index: 100;
  position: absolute;    
  line-height: 200rpx;
  color: green;
  left: 5%;
  top: 5%;
  font-size: x-large ;
}

.op_navigate_bar{
  display: flex;
  justify-content: space-between ;
  align-items: center;
}

.hr_divider{
  width: 15%;
  height: 2rpx;
  background-color: green;
  /* border-bottom: 2rpx green solid; */
}

.op_image{
  height: 20px;
  width: 20px;
  margin: 15px,15px;
}
.bottom{
  height: fit-content;
  position: relative;
}

.bottom_image {
  width: 100%;
  z-index: 1;
  /* position: absolute; */
}

.bottom_companyName {
  z-index: 100;
  position: absolute;
  top:10%;
  left: 25%;
  font-size: medium;
}
.bottom_url {
  z-index: 100;
  position: absolute;
  top:30%;
  left:25%;
  font-size: small;
}
.bottom_text31 {
  z-index: 100;
  position: absolute; 
  top: 50%  ; 
  left: 30%;
  font-size: small; 
  text-align: center;
}
.cls_info_content {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-evenly;
  
  box-sizing: border-box;
  padding: 17rpx;
  height: 560rpx;
}
.weui-tabs-bar__wrp {
  border-bottom: 1px solid #eee;
  margin-top: 10px;
}

.weui-tabs-swiper {
  width: 100%;
  height: 260px;
  margin:0 10rpx 10rpx;
}

.tab-content {
  height: 260px;
  width: 100%;
  white-space:pre-wrap;
  font-size: medium;
}

.weui-tabs-bar__title {
  margin: 0px 10px;
}

.tab-bar-title__selected {
  font-weight: bold;
}
.view_block {
  display: block;
}