<view class="weui-mask" wx:if="{{showEditSection}}">
  <view class="weui_cells">
    <view class="weui-cell">
      <view class="weui-cell__hd">关系</view>
      <view class="weui-cell__bd">
        <picker bindchange="bindWhomChange" value="{{whomforIdx}}" range="{{whomforArray}}">
            <view class="weui-input">{{whomforArray[whomforIdx]}}</view>
        </picker>
      </view>
    </view>
    <view class="weui-cell">
      <view class="weui-cell__hd">纪念诞忌</view>
      <view class="weui-cell__bd">
        <picker bindchange="bindWhatChange" value="{{whatforIdx}}" range="{{whatforArray}}">
            <view class="weui_input">{{whatforArray[whatforIdx]}}</view>
        </picker>
      </view>
    </view>
    <view class="weui-cell">
      <view class="weui-cell__hd">日期(农历)</view>
      <view class="weui-cell__bd">
        <view bindtap="fn_showDPP"> {{shownChinaMD}}</view>       
        <datepicker-plus bind:submit='submitDPP' showDatePickerPlus="{{showDPP}}" >
        </datepicker-plus>
      </view>
    </view>
    <view class="weui-cell">
      <button class="weui-btn_cell" type="primary" bindtap="fn_closeEditSection" size="mini">取消</button>
      <button class="weui-btn_cell" type="primary" bindtap="fn_save" size="mini">保存</button>
    </view>
 </view>
</view>