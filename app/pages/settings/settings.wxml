    <!--pages/settings/settings.wxml-->
<import src="../../commons/head_sk.wxml" />
<import src="../../commons/foot_sk.wxml" />
<import src="../../commons/op_navigate_bar.wxml" />

<view class="container">
  <view class="inner_container">
    <template is="head_sk"/>
    <scroll-view scroll-y="true" class="sv">
      <view class="weui-grids">
        <view class="weui-grid whomfor-grid grid-caption-line"><text>关系</text></view>
        <view class="weui-grid whatfor-grid grid-caption-line"><text>生忌纪念</text></view>
        <view class="weui-grid date-grid grid-caption-line"><text>日期(农历月日)</text></view>
        <view class="weui-grid right-grid grid-caption-line"><text style="white-space:pre-wrap" space="nbsp">  </text></view>

        <block wx:for="{{list}}">
          <view class="weui-grid">{{whomfor_array[item['whom']]}}</view>
          <view class="weui-grid">{{whatfor_array[item['what']]}}</view>
          <view class="weui-grid date-grid">纪念日</view>
          <view class="weui-grid right-grid"><checkbox></checkbox></view>
        </block>
        <view class="weui-grid">纪念日</view>
        <view class="weui-grid">纪念日</view>
        <view class="weui-grid date-grid">纪念日</view>
        <view class="weui-grid right-grid"><checkbox></checkbox></view>        
        <view class="weui-grid">纪念日</view>
        <view class="weui-grid">纪念日</view>
        <view class="weui-grid date-grid">纪念日</view>
        <view class="weui-grid right-grid"><checkbox></checkbox></view>   
      </view>
    </scroll-view> 
    <view class="weui-btn-area_inline">
      <button class="weui-btn" type="primary" size="mini" bindtap="fn_showEditSection">添加</button>
      <button class="weui-btn" type="primary" size="mini" bindtap="fn_removeSelected">删除选中</button>
      <button class="weui-btn" type="primary" size="mini"bindtap="fn_modifySelected">修改选中</button>
    </view>
    <template is="op_navigate_bar" />
    <template is="foot_sk" />
  </view> 
  <!--mask comes here  -->
  <include src="./edit_section.wxml"></include>
</view>
