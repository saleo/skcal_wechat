    <!--pages/settings/settings.wxml-->
<import src="../../commons/head_sk.wxml" />
<import src="../../commons/foot_sk.wxml" />
<import src="../../commons/op_navigate_bar.wxml" />

<view class="container">
  <view class="inner_container">
    <template is="head_sk"/>
    <scroll-view scroll-y="true" class="sv">
      <view class="weui-grids">
        <view class="weui-grid whomfor-grid grid-caption-line"><text>关系</text></view>
        <view class="weui-grid whatfor-grid grid-caption-line"><text>生忌纪念</text></view>
        <view class="weui-grid date-grid grid-caption-line"><text>日期(农历月日)</text></view>
        <view class="weui-grid right-grid grid-caption-line"><checkbox bindtap="tapAllChkbox"></checkbox></view>

        <block wx:for="{{avs_list}}" wx:key="uid">
          <view class="weui-grid">{{whomfor_array[item['whom']]}}</view>
          <view class="weui-grid">{{whatfor_array[item['what']]}}</view>
          <view class="weui-grid date-grid">{{chinaM_array[item['lunarM']]+chinaD_array[item['lunarD']]}}</view>
          <view class="weui-grid right-grid"><checkbox checked="{{item.chked}}" bindtap="tapChkbox" data-uid="{{item['uid']}}"></checkbox></view>
        </block>
      </view>
    </scroll-view> 
    <view class="weui-btn-area_inline">
      <button class="weui-btn" type="primary" size="mini" bindtap="tapAdd">添加</button>
      <button class="weui-btn" type="primary" size="mini" bindtap="tapRemove">删除选中</button>
      <button class="weui-btn" type="primary" size="mini"bindtap="tapUpdate">修改选中</button>
    </view>
    <template is="op_navigate_bar" />
    <template is="foot_sk" />
  </view> 
  <!--mask comes here  -->
  <include src="./edit_section.wxml"></include>
</view>
<mp-dialog title="发现重复" show="{{showDialog}}" mask="true" mask-closable="true" bindbuttontap="fn_tapDialogOK" buttons="{{dialog_buttons}}">
  <view class="sk_wrap">
    <block wx:if="{{currentOp=='a'}}">当前操作:添加\n</block>
    <block wx:elif="{{currentOp}}=='u'">当前操作:修改\n</block>
    与已有生忌纪念日重复，请检查修改
  </view>
</mp-dialog>