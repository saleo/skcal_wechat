    <!--pages/settings/settings.wxml-->
<import src="../../commons/head_sk.wxml" />
<import src="../../commons/foot_sk.wxml" />
<import src="../../commons/op_navigate_bar.wxml" />

<view class="container">
  <view class="inner_container">
    <template is="head_sk"/>
    <scroll-view scroll-y="true" class="sv">
      <view class="weui-grids">
        <view class="weui-grid whomfor-grid grid-caption-line"><text>关系</text></view>
        <view class="weui-grid whatfor-grid grid-caption-line"><text>生忌纪念</text></view>
        <view class="weui-grid date-grid grid-caption-line"><text>日期(农历月日)</text></view>
        <view class="weui-grid right-grid grid-caption-line"><checkbox bindtap="tapAllChkbox" id="allChkbox" checked="{{allChked}}"></checkbox></view>

        <block wx:for="{{avsList}}" wx:key="uid">
          <view class="weui-grid">{{whomforArray[item['whomforIdx']]}}</view>
          <view class="weui-grid">{{whatforArray[item['whatforIdx']]}}</view>
          <view class="weui-grid date-grid">{{chinaMonthArray[item['chinaMonthIdx']]+chinaDayArray[item['chinaDayIdx']]}}</view>
          <view class="weui-grid right-grid"><checkbox checked="{{item.chked}}" bindtap="tapChkbox" data-uid="{{item['uid']}}"></checkbox></view>
        </block>
      </view>
    </scroll-view> 
    <view><checkbox checked="{{autoBackup_chked}}" bindTap="tapAutoBackup"></checkbox><text class="txt_autoback">自动备份到云端服务器上(选中则在离开本页面时自动备份)</text></view>
    <view class="weui-btn-area_inline">
      <button class="weui-btn" type="primary" size="mini" bindtap="tapAdd">添加</button>
      <button class="weui-btn" type="primary" size="mini" bindtap="tapRemove">删除选中</button>
      <button class="weui-btn" type="primary" size="mini"bindtap="tapUpdate">修改选中</button>
      <button class="weui-btn" type="primary" size="mini"bindtap="tapRestore">云端恢复</button>
    </view>
    <template is="op_navigate_bar" />
    <template is="foot_sk" />
  </view> 
  <!--mask comes here  -->
  <include src="./edit_section.wxml"></include>
</view>
<mp-dialog title="发现重复" show="{{showDuplicateWarning}}" mask="true" mask-closable="true" bindbuttontap="fn_tapDuplicateWarningOK" buttons="{{duplicateDlgButtons}}">
  <view class="sk_wrap">
    <block wx:if="{{operate=='a'}}">当前操作:添加\n</block>
    <block wx:elif="{{operate}}=='u'">当前操作:修改\n</block>
    与已有生忌纪念日重复，请检查修改
  </view>
</mp-dialog>
<mp-dialog title="只能修改一个条目" show="{{showOnlyOneWarning}}" mask="true" mask-closable="true" bindbuttontap="fn_tapOnlyOneWarningOK" buttons="{{onlyOneDlgButtons}}">
  <view>只能选中一个条目进行修改</view>
</mp-dialog>