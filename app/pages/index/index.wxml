<!--pages/index/index.wxml-->
<import src="../../commons/head.wxml" />
<import src="../../commons/foot_mottos.wxml" />
<import src="../../commons/utils.wxml" />
<import src="../../commons/op_navigate_bar.wxml" />

<view class="container">

    <template is="head" data="{{year:year,month:month}}"/>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' bindfbi_prompt='fbi_prompt'/>

    <view class="hr_divider"></view>
    
    <template is="foot_mottos" data="{{mottos_digest:mottos_digest,year:year,month:month}}" />

</view>
<template is="utils" data="{{fbi_show:fbi_show,year:year,month:month,day:day,lunarDateMD:lunarDateMD,fbiDesc:fbiDesc,mottos_show:mottos_show,mottos4Month:mottos4Month}}" />