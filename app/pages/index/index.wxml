<!--pages/index/index.wxml-->
<view class="container">

    <view class='banner'>
        <block wx:if="{{year=='2020'||year=='2021'}}">
            <text class="banner_text">{{month}}月</text>
            <image src="../../resources/sk{{year}}.png" mode="widthFix" class="banner_image"/>
        </block>
        <block wx:else>
            <text class="banner_text">{{year}}年{{month}}月</text> 
            <image src="../../resources/skall.png" mode="widthFix" class="banner_image"/>
        </block>
    </view>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' bindfbi_prompt='fbi_prompt'/>

    <view class='bottom'>
        <block wx:if="{{year=='2020'||year=='2021'}}">
            <text class="bottom_text1" bindtap="mottosDigestTap"> {{mottos_digest['y'+year][month][0]}}\n</text>
            <text class="bottom_text2" bindtap="mottosDigestTap"> {{mottos_digest['y'+year][month][1]}}\n</text>
            <text class="bottom_text3" bindtap="mottosDigestTap"> {{mottos_digest['y'+year][month][2]}}</text>
            <image src='../../resources/bottom_bg_transparent1.png' class="bottom_image" mode="widthFix"/>
        </block>
        <block wx:else>
            <text class="bottom_text21"> 商丘市寿康文化研究学会 {{year}}</text>                        
            <rich-text nodes="{{htmlSnip}}" class="bottom_text31"></rich-text>
            <image src='../../resources/bottom_bg_transparent21.png' class="bottom_image" mode="widthFix"/>            
        </block>
    </view>
</view>
<mp-half-screen-dialog 
  show="{{fbi_show}}"
  title="戒期信息" 
  subTitle="{{year}}-{{month}}-{{day}},{{lunarDateMD}}">
    <view slot='desc'>
        <text>{{fbiDesc}}</text>
    </view>

</mp-half-screen-dialog>

<mp-half-screen-dialog 
  show="{{mottos_show}}"
  title="清心格言" >
    <view slot='desc'>
        <text>{{mottos4Month}}</text>
    </view>

</mp-half-screen-dialog>