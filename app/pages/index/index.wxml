<!--pages/index/index.wxml-->
<view class="container">

    <view class='banner'>
        <text class="banner_text">{{month}}月</text>
        <image src="../../resources/sk2021.png" mode="widthFix" class="banner_image"/>
    </view>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' />
<view class='imgBg'>
    {{mottos_digest['y'+year][month][0]}}
</view>
<view style="flex-direction:column">{{mottos_digest['y'+year][month][1]}}</view>
<view style="flex-direction:column">{{mottos_digest['y'+year][month][2]}}</view>
</view>