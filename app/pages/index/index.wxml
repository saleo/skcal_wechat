<!--pages/index/index.wxml-->
<view class="container">

    <view class='banner'>
        <text class="banner_text">{{month}}月</text>
        <image src="../../resources/sk2021.png" mode="widthFix" class="banner_image"/>
    </view>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' />

    <view class='bottom'>
        <text class="bottom_text1"> {{mottos_digest['y'+year][month][0]}}\n</text>
        <text class="bottom_text2"> {{mottos_digest['y'+year][month][1]}}\n</text>
        <text class="bottom_text3"> {{mottos_digest['y'+year][month][2]}}</text>
        <image src='../../resources/bottom_bg_transparent1.png' class="bottom_image" mode="widthFix"/>
    </view>
</view>