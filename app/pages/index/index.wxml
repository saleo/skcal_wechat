<!--pages/index/index.wxml-->
<view class="container">

    <view class='banner'>
        <text wx:if="{{year=='2020'||year=='2021'}}" class="banner_text">{{month}}月</text>
        <text wx:else class="banner_text">{{month}}月{{year}}年</text> 

        <image wx:if="{{year=='2020'||year=='2021'}}" src="../../resources/sk{{year}}.png" mode="widthFix" class="banner_image"/>
        <image wx:else src="../../resources/sk_banner.png" mode="widthFix" class="banner_image"/>
    </view>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' />

    <view class='bottom'>
        <text class="bottom_text1"> {{mottos_digest['y'+year][month][0]}}\n</text>
        <text class="bottom_text2"> {{mottos_digest['y'+year][month][1]}}\n</text>
        <text class="bottom_text3"> {{mottos_digest['y'+year][month][2]}}</text>
        <image src='../../resources/bottom_bg_transparent1.png' class="bottom_image" mode="widthFix"/>
    </view>
</view>