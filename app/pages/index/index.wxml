<!--pages/index/index.wxml-->
<view class="container">

    <view class='banner'>
        <block wx:if="{{year=='2020'||year=='2021'}}">
            <text class="banner_text">{{month}}月</text>
            <image src="../../resources/sk{{year}}.png" mode="widthFix" class="banner_image"/>
        </block>
        <block wx:else>
            <image src="../../resources/sk_banner.png" mode="widthFix" class="banner_image"/>
        </block>
    </view>

    <calendar value='{{year}}-{{month}}-{{day}}' bindchange='change' />

    <view class='bottom'>
        <block wx:if="{{year=='2020'||year=='2021'}}">
            <text class="bottom_text1"> {{mottos_digest['y'+year][month][0]}}\n</text>
            <text class="bottom_text2"> {{mottos_digest['y'+year][month][1]}}\n</text>
            <text class="bottom_text3"> {{mottos_digest['y'+year][month][2]}}</text>
            <image src='../../resources/bottom_bg_transparent1.png' class="bottom_image" mode="widthFix"/>
        </block>
        <block wx:else>
            <rich-text nodes="{{htmlSnip}}" class="bottom_text21"></rich-text>
            <text class="bottom_text31"> 商丘市寿康文化研究学会 {{year}}</text>                        
            <image src='../../resources/bottom_bg_transparent21.png' class="bottom_image" mode="widthFix"/>            
        </block>
    </view>
</view>